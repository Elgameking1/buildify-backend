# ---------------------------------------------------------------------------
# Copy to .env and fill in.  Never commit the real .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=true

# --- Database -------------------------------------------------------------
# When running under Docker Compose the host is the service name: "mysql".
# When running the API directly on your machine, use 127.0.0.1.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=marketplace
MYSQL_PASSWORD=marketplace
MYSQL_DATABASE=marketplace
MYSQL_ROOT_PASSWORD=rootpassword

# CA certificate used to verify the database's TLS certificate. Leave empty for
# a database on a private network (Docker Compose here, Railway internally).
# Required for managed MySQL reached over the internet - Aiven, Cloud SQL, RDS
# all sign with their own CA, so the system trust store is not enough on its
# own. Accepts either a path to a .pem file or the PEM block inline, since a
# host that only offers environment variables cannot hold a file.
# MYSQL_SSL_CA=

# Connection pool per process. Defaults are deliberately small: Aiven's free
# MySQL allows 76 connections in total and each process can hold
# DB_POOL_SIZE + DB_MAX_OVERFLOW of them.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --- Security -------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-this-is-not-a-real-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Password reset -------------------------------------------------------
# PASSWORD_RESET_EXPIRE_MINUTES=30

# Hand the reset link back in the API response instead of emailing it.
#
# Leave this FALSE anywhere real. With it true, anyone who can name a
# registered email address is handed a working reset link for that account -
# that is account takeover, not a password reset. It exists only because this
# deployment has no mail provider, and the alternative is a demo where the
# flow cannot be completed at all. Turn it on to demonstrate, then off again.
# PASSWORD_RESET_RETURN_LINK=false

# --- CORS -----------------------------------------------------------------
# Comma separated. Must list the exact frontend origins - no wildcards.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Proxy ----------------------------------------------------------------
# Whether to believe X-Forwarded-For when rate limiting. Leave unset: it then
# follows ENVIRONMENT (on in production, where a proxy rewrites the header;
# off locally, where trusting a caller-supplied header would let anyone defeat
# the login rate limit). Set it to true only if a trusted proxy sits in front.
# TRUST_PROXY_HEADERS=true

# --- Paystack -------------------------------------------------------------
# Keys from dashboard.paystack.com -> Settings -> API Keys & Webhooks.
# Test keys (sk_test_/pk_test_) work end to end without real money.
# Leaving PAYSTACK_SECRET_KEY empty switches the pay button off in the UI
# rather than failing at checkout.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_CURRENCY=GHS

# Where Paystack returns the browser after checkout. A FRONTEND route - the
# page there calls back in to verify. Defaults to the first CORS origin plus
# /payment/callback, which is correct for a normal deployment.
# PAYSTACK_CALLBACK_URL=https://your-app.vercel.app/payment/callback

# Also set the webhook URL in the Paystack dashboard to:
#   https://<your-backend>/api/v1/payments/webhook
# It is what confirms payments when the customer closes the tab mid-checkout.

# --- Cloudflare R2 --------------------------------------------------------
# Create an R2 bucket + API token at dash.cloudflare.com -> R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marketplace-media
# Public read URL for the bucket: either the r2.dev subdomain or your own
# custom domain, WITHOUT a trailing slash.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev
R2_PRESIGN_EXPIRE_SECONDS=900
MAX_UPLOAD_BYTES=5242880
